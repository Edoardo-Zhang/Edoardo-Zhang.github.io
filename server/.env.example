# 复制为 .env 放在服务器上（chmod 600），只在这台机器上使用。
# 这些值是服务器机密，不会、也不应该出现在前端构建产物里。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=bitjiaxin
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=zuoyexiang/
PORT=3000
# 只监听本机，外部一律经 nginx 反代（不要改成 0.0.0.0）
HOST=127.0.0.1
# 单个文件上限（字节），默认 500MB
MAX_FILE_BYTES=524288000

# ---- 登录与管理员（用 node scripts/setup-admin.mjs <学号> 自动写入，不要手填口令明文）----
# 管理员学号（10 位，可逗号分隔多个）
ADMIN_STUDENT_IDS=
# 管理员口令的 scrypt 哈希（scrypt$salt$hash）
ADMIN_PASSWORD_HASH=
# 会话签名密钥（随机长字符串；更换后所有人需重新登录）
SESSION_SECRET=
# 仅本机 http 调试时设为 1（线上 https 保持不设）
# COOKIE_INSECURE=1
